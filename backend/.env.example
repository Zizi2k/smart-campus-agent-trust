# ==============================================================================
# SMART CAMPUS AGENT TRUST - BACKEND LOCAL ENVIRONMENT
# Sao chép file này thành .env trước khi chạy: copy backend\.env.example backend\.env
# ==============================================================================

# Database PostgreSQL (Docker local container)
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_audit"
PORT=3100

# Khóa bí mật ký JWT token (yêu cầu tối thiểu 16 ký tự)
JWT_SECRET="smart-campus-jwt-secret-key-super-secure-2026"

# Hardhat Local Blockchain Node RPC (mặc định cổng 8545)
RPC_URL="http://127.0.0.1:8545"

# Địa chỉ Smart Contract CampusAgentRegistry sau khi deploy lần đầu trên Hardhat
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Private key của Backend Relayer Signer
# Lưu ý: Đây là Private Key mặc định công khai của Hardhat Account #0 (10,000 ETH giả lập).
# Chỉ có hiệu lực trên máy local, an toàn 100% và không có giá trị trên mạng thật.
BACKEND_SIGNER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Tài khoản Admin khởi tạo (mật khẩu yêu cầu tối thiểu 12 ký tự)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="campuspassword123"
